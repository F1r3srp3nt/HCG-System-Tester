<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>HCG System Tester</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>HCG System Tester</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hakmicapitalgroup.systemtester.navigation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hcgsystemtester</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>HCG System Tester scans for Bluetooth devices only when you start a scan, and reads standard device-information characteristics only from a device you approve. It never writes to devices.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>HCG System Tester discovers devices on your local network (Bonjour and UPnP/SSDP) only when you start a discovery, and reads public device information only from devices you select.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_hap._tcp</string>
		<string>_matter._tcp</string>
		<string>_matterc._udp</string>
		<string>_meshcop._udp</string>
		<string>_device-info._tcp</string>
		<string>_ssh._tcp</string>
		<string>_workstation._tcp</string>
		<string>_ipp._tcp</string>
		<string>_smb._tcp</string>
		<string>_companion-link._tcp</string>
		<string>_mqtt._tcp</string>
		<string>_http._tcp</string>
		<string>_spotify-connect._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Hakmi Capital Group</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
</dict>
